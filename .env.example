# Runtime
# Safe local flow: test ledger money only; no blockchain deposits or withdrawals.
NODE_ENV=development
FUNDS_MODE=test
DEPOSIT_MODE=disabled
PORT=4000
DATABASE_URL=postgresql://red_envelope:red_envelope@localhost:5432/red_envelope?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Telegram
# Create the bot with @BotFather. Never commit the real token.
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
# Must be the complete HTTPS endpoint, including /telegram/webhook.
TELEGRAM_WEBHOOK_URL=
# HTTPS URL opened by the bot's Mini App button. Use a public tunnel URL for Telegram testing.
PUBLIC_APP_URL=http://localhost:5173
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Telegram numeric ID of the funded user wallet used for admin-created envelopes.
RED_ENVELOPE_TREASURY_TELEGRAM_ID=

# Admin console
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_ROLE=SUPER_ADMIN
# Optional base32 TOTP secret. Required at login when configured.
ADMIN_MFA_SECRET=

# Tron / TRC20 USDT
TRON_FULL_HOST=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRON_HOT_WALLET_ADDRESS=
HOT_WALLET_PRIVATE_KEY=
TRON_CONFIRMATIONS=19
HOT_WALLET_CAP_USDT=500

# Withdrawal policy
WITHDRAWAL_MIN_USDT=20
WITHDRAWAL_FEE_USDT=1
WITHDRAWAL_AUTO_APPROVAL_LIMIT=50

# Abuse controls
RATE_LIMIT_PER_MINUTE=60
CLAIM_RATE_LIMIT_PER_MINUTE=20

# Local testing only. FUNDS_MODE=test prevents this balance from reaching the chain.
ALLOW_DEV_CREDIT=true

# Real-money deployment requires all of these together:
# NODE_ENV=production
# FUNDS_MODE=real
# DEPOSIT_MODE=unique
# ALLOW_DEV_CREDIT=false
# Each User.depositAddress must be provisioned by reviewed self-custody infrastructure
# or a custody provider. Runtime switching from test to real in the admin UI is
# intentionally forbidden; change the environment and restart after review.
