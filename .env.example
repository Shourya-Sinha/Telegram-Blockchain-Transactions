# Runtime
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Telegram
BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.example/telegram/webhook
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# PostgreSQL / Redis
DATABASE_URL=postgresql://red_envelope:red_envelope@localhost:5432/red_envelope?schema=public
REDIS_URL=redis://localhost:6379

# Tron / USDT TRC20
TRONGRID_API_KEY=replace-with-trongrid-api-key
TRON_FULL_HOST=https://api.trongrid.io
TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRON_HOT_WALLET_ADDRESS=replace-with-hot-wallet-address
# Never commit a private key. In production use AWS KMS or HashiCorp Vault instead.
HOT_WALLET_PRIVATE_KEY=replace-with-secret
TRON_CONFIRMATIONS=19
HOT_WALLET_CAP_USDT=500

# Financial policy (all converted to 6-decimal minor units server-side)
WITHDRAWAL_MIN_USDT=20
WITHDRAWAL_FEE_USDT=1
WITHDRAWAL_AUTO_APPROVAL_LIMIT=50

# Abuse protection
RATE_LIMIT_PER_MINUTE=60
CLAIM_RATE_LIMIT_PER_MINUTE=20

# Admin bootstrap (used only by prisma seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_ROLE=SUPER_ADMIN
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRES_IN=12h
