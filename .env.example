# Red Envelope Wallet environment template. Keep real funds disabled until custody,
# reconciliation, legal, and operational reviews are complete.
NODE_ENV=development
FUNDS_MODE=test
DEPOSIT_MODE=disabled
ALLOW_DEV_CREDIT=false
DEV_AUTO_CREDIT_USDT=0
MINE_GAME_REAL_FUNDS_ENABLED=false

DATABASE_URL=postgresql://red_envelope:red_envelope@localhost:5432/red_envelope?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MINI_APP_SHORT_NAME=
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=development-only-change-me
JWT_EXPIRES_IN=12h

# Real TRC20 operations require reviewed key management and unique user addresses.
TRON_FULL_HOST=https://api.trongrid.io
TRONGRID_API_KEY=
TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRON_HOT_WALLET_ADDRESS=
HOT_WALLET_PRIVATE_KEY=
TRON_CONFIRMATIONS=19
HOT_WALLET_CAP_USDT=500
WITHDRAWAL_MIN_USDT=20
WITHDRAWAL_FEE_USDT=1
WITHDRAWAL_AUTO_APPROVAL_LIMIT=50
RED_ENVELOPE_TREASURY_TELEGRAM_ID=
