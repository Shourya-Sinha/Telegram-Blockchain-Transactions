# Copy to server/.env and client/.env as needed
MONGO_URI=mongodb://localhost:27017/tbt_chain
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173
# Token / chain config
TOKEN_SYMBOL=TBT
TOKEN_NAME=Telegram Blockchain Token
BLOCK_TIME_MS=10000
MAX_TX_PER_BLOCK=10
MAX_TX_PER_USER_PER_BLOCK=2
TX_FEE_PERCENT=0.1
TX_FEE_MIN=0.01
FAUCET_AMOUNT=100
FAUCET_COOLDOWN_MS=3600000
DAILY_SEND_LIMIT=10000
LARGE_TX_APPROVAL_THRESHOLD=5000
# Telegram bot (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# AES-256 key for custodial wallet encryption (32 bytes hex = 64 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=
# Optional: real EVM settlement (Sepolia etc). Leave empty to use embedded chain only.
EVM_RPC_URL=
EVM_SETTLEMENT_KEY=
EVM_ANCHOR_MODE=off
EVM_CHAIN_ID=11155111
EVM_ANCHOR_ADDRESS=
# Seed admin
SEED_ADMIN_EMAIL=admin@tbt.local
SEED_ADMIN_PASSWORD=Admin123!
