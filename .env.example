# ---------------------------------------------------------------------------
# Red Envelope Wallet — environment template
# Copy to .env and fill in every value. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
NODE_ENV=development
# test  = no blockchain operations; safe development balances only.
# real  = live TRC20 deposits/withdrawals (requires every Tron variable below).
FUNDS_MODE=test
# disabled = no deposit addresses (test default); unique = per-user deposit addresses (real default).
DEPOSIT_MODE=disabled
PORT=4000
DATABASE_URL=postgresql://red_envelope:red_envelope@localhost:5432/red_envelope?schema=public
REDIS_URL=redis://localhost:6379

# Telegram -------------------------------------------------------------------
BOT_TOKEN=
# Public HTTPS URL of the Mini App. Also used for the bot's chat menu button,
# /start, /wallet and the wallet button under every red envelope message.
PUBLIC_APP_URL=http://localhost:5173
# Public HTTPS webhook URL. Localhost/empty automatically falls back to long polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Required test TRC20 address for simulated withdrawals while FUNDS_MODE=test.
# Leave empty to keep the Withdraw button disabled in test mode.
# Must NOT be set when FUNDS_MODE=real.
TEST_WITHDRAWAL_ADDRESS=

# Admin console ---------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_ROLE=SUPER_ADMIN
JWT_SECRET=development-only-change-me
JWT_EXPIRES_IN=12h

# Tron / TRC20 USDT -----------------------------------------------------------
TRONGRID_API_KEY=
TRON_FULL_HOST=https://api.trongrid.io
TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRON_HOT_WALLET_ADDRESS=
HOT_WALLET_PRIVATE_KEY=
TRON_CONFIRMATIONS=19
HOT_WALLET_CAP_USDT=500

# Withdrawal rules -------------------------------------------------------------
WITHDRAWAL_MIN_USDT=20
WITHDRAWAL_FEE_USDT=1
WITHDRAWAL_AUTO_APPROVAL_LIMIT=50

# Rate limits -------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
CLAIM_RATE_LIMIT_PER_MINUTE=20

# Test-only credits ----------------------------------------------------------------
# One-time welcome balance per user. Never enabled in production or real-funds mode.
ALLOW_DEV_CREDIT=false
DEV_AUTO_CREDIT_USDT=0

# Treasury ---------------------------------------------------------------------
# Telegram ID of the funded treasury account that pays for admin-created envelopes.
# Run /myid from that account to get the number.
RED_ENVELOPE_TREASURY_TELEGRAM_ID=

# Postgres (docker compose) ------------------------------------------------------
POSTGRES_DB=red_envelope
POSTGRES_USER=red_envelope
POSTGRES_PASSWORD=red_envelope
